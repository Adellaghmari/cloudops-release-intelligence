# Local development only. Copy to .env and fill locally.
# Never commit real values. Never paste secrets into chat.

APP_ENV=local
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=info
APP_VERSION=0.1.0-dev
APP_SERVICE_NAME=cloudops-api
APP_SEED_LOCAL=true
APP_CORS_ORIGINS=http://localhost:4200

# AWS region for the eventual production environment.
AWS_REGION=eu-west-1

# Local/dev table and bucket names. Production names come from Terraform.
DDB_TABLE_NAME=cloudops-main-local
S3_RAW_EVENTS_BUCKET=cloudops-raw-events-local
EVENT_BUS_NAME=cloudops-release-events-local
ANALYSIS_QUEUE_URL=

# Leave empty for local in-memory/dev mode until DynamoDB local is wired.
AWS_ENDPOINT_URL=

# GitHub webhook verification. Required only when webhook ingestion is enabled.
GITHUB_WEBHOOK_SECRET=
